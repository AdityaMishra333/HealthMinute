{
  "name": "functions",
  "description": "Cloud Functions for HealthMinute — server-side SOS alert sending via Twilio.",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "scripts": {
